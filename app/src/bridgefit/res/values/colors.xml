<?xml version="1.0" encoding="utf-8"?>
<!--
    Bridge Fit: re-skin of every upstream Gadgetbridge screen.
    The upstream themes (app/src/main/res/values/styles.xml) point at these leaf colors; redefining only the
    colors keeps the theme structure owned by upstream, so merges stay conflict-free.
    Values follow the Bridge Fit palette (ui/theme/Theme.kt): iOS grouped backgrounds and the system blue accent.
-->
<resources>
    <!-- Accent: the iOS system blue instead of Gadgetbridge orange. -->
    <color name="primary_light" type="color">#007AFF</color>
    <color name="primarydark_light" type="color">#007AFF</color>
    <color name="primary_dark" type="color">#0A84FF</color>
    <color name="primarydark_dark" type="color">#0A84FF</color>
    <color name="accent" type="color">#0A84FF</color>
    <color name="subtab_pill_light" type="color">#D6E8FF</color>
    <color name="subtab_pill_dark" type="color">#0B2A4D</color>
    <color name="subtab_pill_on_dark" type="color">#64B0FF</color>

    <!-- Light: grouped background with white surfaces. -->
    <color name="window_background_light" type="color">#F2F2F7</color>
    <color name="surface_container_lowest_light" type="color">#FFFFFF</color>
    <color name="surface_container_low_light" type="color">#FFFFFF</color>
    <color name="surface_container_light" type="color">#FFFFFF</color>
    <color name="surface_container_high_light" type="color">#E5E5EA</color>
    <color name="surface_container_highest_light" type="color">#D1D1D6</color>
    <color name="on_surface_variant_light" type="color">#6C6C70</color>
    <color name="outline_light" type="color">#8E8E93</color>
    <color name="outline_variant_light" type="color">#C6C6C8</color>
    <color name="row_separator_light" type="color">#FFC6C6C8</color>

    <!-- Dark: true black with #1C1C1E surfaces. -->
    <color name="window_background_dark" type="color">#000000</color>
    <color name="surface_container_lowest_dark" type="color">#000000</color>
    <color name="surface_container_low_dark" type="color">#1C1C1E</color>
    <color name="surface_container_dark" type="color">#1C1C1E</color>
    <color name="surface_container_high_dark" type="color">#2C2C2E</color>
    <color name="surface_container_highest_dark" type="color">#3A3A3C</color>
    <color name="on_surface_variant_dark" type="color">#8E8E93</color>
    <color name="outline_dark" type="color">#8E8E93</color>
    <color name="outline_variant_dark" type="color">#38383A</color>
    <color name="row_separator_dark" type="color">#38383A</color>

    <!-- Sleep stages and activity, matching the Bridge Fit charts. -->
    <color name="chart_deep_sleep_light" type="color">#3634A3</color>
    <color name="chart_deep_sleep_dark" type="color">#3634A3</color>
    <color name="chart_light_sleep_light" type="color">#0A84FF</color>
    <color name="chart_light_sleep_dark" type="color">#0A84FF</color>
    <color name="chart_rem_sleep_light" type="color">#5AC8FA</color>
    <color name="chart_rem_sleep_dark" type="color">#5AC8FA</color>
    <color name="chart_awake_sleep_light" type="color">#FF8A65</color>
    <color name="chart_awake_sleep_dark" type="color">#FF8A65</color>
    <color name="chart_activity_light" type="color">#2EB82E</color>
    <color name="chart_activity_dark" type="color">#A4F02A</color>
</resources>

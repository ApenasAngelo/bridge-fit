<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 style back button: a chevron in a circle, used as the up indicator of upstream screens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="38dp"
        android:height="38dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="center">
        <vector
            android:width="20dp"
            android:height="20dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="#00000000"
                android:pathData="M15,4.5 L7.5,12 L15,19.5"
                android:strokeWidth="2.6"
                android:strokeColor="?attr/colorOnSurface"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </item>
</layer-list>

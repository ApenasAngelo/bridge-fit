<?xml version="1.0" encoding="utf-8"?>
<!--
    Bridge Fit: manifest overlay of the bridgefit flavor.
    The new Compose UI becomes the launcher entry; ControlCenterv2 stays declared (it is the
    "Classic interface" and is still the parent of many upstream screens), but loses its launcher filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="nodomain.freeyourgadget.gadgetbridge.activities.ControlCenterv2"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Process-start hooks: redirects ControlCenterv2 launches, re-skins upstream screens. Serves no data. -->
        <provider
            android:name="com.apenasangelo.bridgefit.BridgeFitBootstrap"
            android:authorities="${applicationId}.bridgefit_bootstrap"
            android:exported="false" />

        <activity
            android:name="com.apenasangelo.bridgefit.BridgeFitActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
